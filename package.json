{
  "name": "crossban-review",
  "version": "0.1.1",
  "description": "A Twitch moderation workspace for reviewing reports and explicitly selected bans, locally or in your browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "src/",
    "public/",
    "tests/",
    "examples/",
    "scripts/",
    ".github/",
    ".env.example",
    "Start.cmd",
    "START-HERE.txt",
    "README.md",
    "README.nl.md",
    "LICENSE",
    "tsconfig.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "site/"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:pages": "node scripts/Build-Pages.mjs",
    "preview:pages": "node scripts/Preview-Pages.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
